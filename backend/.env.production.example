# ═══════════════════════════════════════════════════════════════════════════════
#  AIM Marketplace — PRODUCTION environment template
#  Copy this to .env on your Pinnacle VPS and fill in every value.
#  NEVER commit the filled-in .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_50_CHARS_MINIMUM
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ─── PostgreSQL (required in production) ──────────────────────────────────────
DB_NAME=aim_db
DB_USER=aim_user
DB_PASSWORD=STRONG_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Example using Gmail — use an App Password, not your main password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
ADMIN_USER_NAME=AIM Admin
ADMIN_USER_EMAIL=admin@yourdomain.com

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-minio-or-s3-key
AWS_SECRET_ACCESS_KEY=your-minio-or-s3-secret
AWS_STORAGE_BUCKET_NAME=aim-content
AWS_S3_REGION_NAME=us-east-1
# For real S3 remove the endpoint URL line. For MinIO VPS:
AWS_S3_ENDPOINT_URL=https://minio.yourdomain.com

# ─── Paystack (live keys from dashboard.paystack.com) ─────────────────────────
PAYSTACK_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_LIVE_PUBLIC_KEY

# ─── M-Pesa / Safaricom Daraja (production keys from developer.safaricom.co.ke) ─
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=YOUR_PRODUCTION_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_PRODUCTION_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_TILL_OR_PAYBILL_NUMBER
MPESA_PASSKEY=YOUR_LIPA_NA_MPESA_PASSKEY
MPESA_CALLBACK_URL=https://yourdomain.com/api/transactions/mpesa/webhook/
MPESA_ACCOUNT_REFERENCE=AIM
MPESA_TRANSACTION_DESC=AIM Marketplace Payment

# ─── Frontend & Platform ──────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
PLATFORM_FEE_PERCENT=15
MINIMUM_SELLER_STAKE=500
ESCROW_AUTO_RELEASE_HOURS=72

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_SECRET_KEY

# ─── Security ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_BYTES_LONG_KEY

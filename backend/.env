# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-development-key-for-aim-marketplace-123456789
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev — switch to PostgreSQL for docker)
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# PostgreSQL (used via docker-compose)
# DB_NAME=aim_db
# DB_USER=aim_user
# DB_PASSWORD=aim_password
# DB_HOST=localhost
# DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO (local S3-compatible storage)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_STORAGE_BUCKET_NAME=aim-content
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000

# Paystack (replace with real test keys)
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# Frontend URL (used in Paystack callback)
FRONTEND_URL=http://localhost:3000

# Platform business rules
PLATFORM_FEE_PERCENT=15
MINIMUM_SELLER_STAKE=500
ESCROW_AUTO_RELEASE_HOURS=72

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Security
ENCRYPTION_KEY=development-32-byte-encryption-key

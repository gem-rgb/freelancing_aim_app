# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-development-key-for-aim-marketplace-123456789
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (leave DB_NAME blank or 'db.sqlite3' to use SQLite) ─────────────
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Email / SMTP (leave EMAIL_HOST blank to use console backend in dev) ──────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
ADMIN_USER_NAME=AIM Admin
ADMIN_USER_EMAIL=

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ─── MinIO (local S3-compatible storage) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_STORAGE_BUCKET_NAME=aim-content
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# ─── M-Pesa / Safaricom Daraja ────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=http://localhost:8000/api/transactions/mpesa/webhook/
MPESA_ACCOUNT_REFERENCE=AIM
MPESA_TRANSACTION_DESC=AIM Marketplace Payment

# ─── Frontend & Platform ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=
